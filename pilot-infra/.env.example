# =============================================================
# ShopPilot 本地开发环境变量
# 复制为 .env 使用：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不要提交
# =============================================================

# ---- MySQL（本机实例，非 Docker） ----
# 启动：bash pilot-infra/scripts/mysql-start.sh start
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=shop_pilot
MYSQL_USER=root
MYSQL_PASSWORD=1234
MYSQL_ROOT_PASSWORD=1234

# ---- PostgreSQL + pgvector（可选，Docker 未装时可不启用） ----
# MySQL 社区版不支持 DISTANCE()/HNSW，若要做数据库侧向量检索再启用 PG
PG_USER=pilot
PG_PASSWORD=pilot123456
PG_DATABASE=shop_pilot_vector

# ---- Redis（可选，本机 6379 已有实例在跑） ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- Java 后端 ----
SERVER_PORT=8080
AGENT_BASE_URL=http://localhost:8000
INTERNAL_TOKEN=dev-internal-token-change-me

# ---- Python Agent ----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
