# 复制为 .env 后按需修改
#
# 注意：以下均为**本地开发默认值**，与 docker-compose.yml 里的 fallback 保持一致，
# 保证复制即用。部署到任何非本机环境前必须全部改掉，否则等于数据库裸奔。

MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=shop_pilot

PG_USER=pilot
PG_PASSWORD=pilot123456
PG_DATABASE=shop_pilot_vector

# Redis 密码（本地默认无密码，若开启了 requirepass 在此填写）
# REDIS_PASSWORD=
