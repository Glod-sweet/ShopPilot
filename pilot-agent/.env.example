# 复制为 .env 后填写
APP_ENV=dev
HOST=0.0.0.0
PORT=8000

# ---- LLM：阿里云百炼（OpenAI 兼容协议） ----
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1500
# 多模态识图模型（qwen-plus 不支持图片）
VL_MODEL=qwen3-vl-plus
# 向量模型，text-embedding-v2 为 1536 维
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_DIM=1536

# ---- 网络检索：Tavily MCP ----
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
MCP_ENABLED=true
TAVILY_MCP_COMMAND=npx
TAVILY_MCP_ARGS=-y,tavily-mcp@0.2.22

# ---- 会话记忆（Redis）。留空则降级为进程内存 ----
# 格式 redis://:<密码>@host:port/db，密码按本地实际情况填
REDIS_URL=redis://:your-redis-password@127.0.0.1:6379/0
MEMORY_TTL_SECONDS=604800
MEMORY_MAX_TURNS=12
MEMORY_KEEP_TURNS=6

# ---- 上下文工程 ----
CONTEXT_MAX_HISTORY=20
CONTEXT_MAX_CHARS=6000

# 与 Java 侧共享的服务间密钥，必须与 pilot-server 的 pilot.agent.internal-token 一致
INTERNAL_TOKEN=dev-internal-token-change-me

# Java 后端地址，工具反向调用用
JAVA_BASE_URL=http://localhost:8080
