# 复制为 .env 后填写
APP_ENV=dev
HOST=0.0.0.0
PORT=8000

# 模型配置，兼容 OpenAI 协议的服务均可
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# 与 Java 侧共享的服务间密钥，必须与 pilot-server 的 pilot.agent.internal-token 一致
INTERNAL_TOKEN=dev-internal-token-change-me

# Java 后端地址，工具反向调用用
JAVA_BASE_URL=http://localhost:8080
